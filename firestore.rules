rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'rating', 'answers', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && (request.resource.data.email == null || request.resource.data.email is string)
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.answers is list;
      allow update: if false;
      allow delete: if request.auth != null;
    }
    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'reply', 'createdAt', 'repliedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() < 2000
                    && request.resource.data.reply == null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'repliedAt']);
      allow delete: if request.auth != null;
    }
    match /stats/siteVisits {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']) &&
        (request.resource.data.count == resource.data.count + 1 ||
         request.resource.data.count == resource.data.count - 1);
    }
    match /downloads/{appId} {
      allow get: if true;

      // ایجاد اولین سند برای یک اپ: شمارنده‌ی کل (count) باید ۱ باشه؛
      // اگر همزمان شمارنده‌ی سایت یا صفحه‌ی دانلود هم فرستاده بشه، اون هم باید ۱ باشه
      allow create: if request.resource.data.keys().hasOnly([
                      'count', 'siteCount', 'siteLastDownloadAt',
                      'pageCount', 'pageLastDownloadAt'
                    ])
                    && request.resource.data.count == 1
                    && request.resource.data.get('siteCount', 1) == 1
                    && request.resource.data.get('pageCount', 1) == 1;

      // افزایش شمارنده‌ی کل + شمارنده و تاریخ دانلود از «داخل سایت»
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['count', 'siteCount', 'siteLastDownloadAt'])
        && request.resource.data.count == resource.data.get('count', 0) + 1
        && request.resource.data.siteCount == resource.data.get('siteCount', 0) + 1;

      // افزایش شمارنده‌ی کل + شمارنده و تاریخ دانلود از «صفحه‌ی دانلود مستقل»
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['count', 'pageCount', 'pageLastDownloadAt'])
        && request.resource.data.count == resource.data.get('count', 0) + 1
        && request.resource.data.pageCount == resource.data.get('pageCount', 0) + 1;
    }
    match /licenseRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'whatsapp', 'license_sent', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 150
                    && request.resource.data.whatsapp is string
                    && request.resource.data.whatsapp.size() > 0
                    && request.resource.data.whatsapp.size() < 30
                    && request.resource.data.license_sent == false;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['license_sent']);
      allow delete: if request.auth != null;
    }
    match /rates/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
