rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  نظرات کاربران (reviews) — نمایش عمومی روی سایت
    // ═══════════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;                 // همه می‌تونن نظرات رو ببینن
      allow create: if true;                // همه می‌تونن نظر ثبت کنن
      allow update, delete: if request.auth != null; // فقط ادمین حذف/ویرایش می‌کنه
    }

    // ═══════════════════════════════════════════════════════════════
    //  پرسش و پاسخ (questions) — نمایش عمومی روی سایت
    // ═══════════════════════════════════════════════════════════════
    match /questions/{questionId} {
      allow read: if true;                 // همه می‌تونن سوال/جواب‌ها رو ببینن
      allow create: if true;                // همه می‌تونن سوال بپرسن
      allow update, delete: if request.auth != null; // فقط ادمین پاسخ می‌ده/حذف می‌کنه
    }

    // ═══════════════════════════════════════════════════════════════
    //  آمار بازدید سایت و دانلود اپ‌ها — شمارنده‌های عمومی
    // ═══════════════════════════════════════════════════════════════
    match /stats/{statId} {
      allow read: if true;
      allow write: if true;   // فقط افزایش شمارنده (increment) — مثل قبل
    }

    match /downloads/{appId} {
      allow read: if true;
      allow write: if true;   // فقط افزایش شمارنده (increment) — مثل قبل
    }

    // ═══════════════════════════════════════════════════════════════
    //  نرخ ارز (rates) — خوانده می‌شود توسط سایت، نوشته می‌شود توسط
    //  Cloud Function نرخ ارز (که با Admin SDK کار می‌کند و از این
    //  قانون‌ها اصلاً عبور نمی‌کند، پس محدودیت write این‌جا بی‌اثر است
    //  ولی برای شفافیت نگه داشته شده)
    // ═══════════════════════════════════════════════════════════════
    match /rates/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  درخواست‌های رزرو لایسنس (licenseRequests) — از مودال «خرید لایسنس»
    //  در صفحه اصلی سایت ثبت می‌شود. چون حاوی ایمیل و شماره واتس‌آپ واقعیِ
    //  کاربرانه (برخلاف reviews/questions که عمومی‌اند)، فقط پنل ادمین
    //  اجازه‌ی خواندنش رو داره؛ اما هر بازدیدکننده‌ای می‌تونه یک درخواست
    //  جدید بسازه. فیلد license_sent (که در ابتدا false ساخته می‌شود) را
    //  فقط ادمین، بعد از ارسال واقعی لایسنس، به true تغییر می‌دهد.
    // ═══════════════════════════════════════════════════════════════
    match /licenseRequests/{requestId} {
      allow read: if request.auth != null;   // فقط پنل ادمین می‌بیندشون
      allow create: if true;                  // هر کاربری می‌تونه درخواست ثبت کنه
      allow update, delete: if request.auth != null; // فقط ادمین (license_sent، حذف و ...)
    }

    // ═══════════════════════════════════════════════════════════════
    //  لایسنس‌ها — کالکشن حساس. ساخت/مصرف واقعی فقط توسط سرور لایسنس
    //  (Admin SDK روی Render) انجام می‌شود و این قانون‌ها رویش اثر ندارند.
    //  این‌جا فقط دسترسی از طریق مرورگر (سایت/پنل ادمین) را کنترل می‌کنیم.
    // ═══════════════════════════════════════════════════════════════
    match /licenses/{licenseCode} {
      allow read: if request.auth != null;  // فقط پنل ادمین می‌بیندشون
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['delivered', 'delivered_at']);
      allow create, delete: if false;       // فقط سرور می‌سازه/پاک می‌کنه
    }

    // ═══════════════════════════════════════════════════════════════
    //  کدهای تخفیف — ساختنش از پنل ادمین مجازه، ولی «مصرف‌کردن» (used:true
    //  شدن) فقط سمت سرور لایسنس اتفاق می‌افتد.
    // ═══════════════════════════════════════════════════════════════
    match /discountCodes/{code} {
      allow read: if request.auth != null;   // پنل ادمین لیستشون رو نشون می‌ده
      allow create: if request.auth != null; // پنل ادمین کد جدید می‌سازه
      allow update, delete: if false;        // فقط سرور لایسنس مصرفش می‌کنه
    }

    // ═══════════════════════════════════════════════════════════════
    //  سفارش‌ها — فقط سرور لایسنس می‌سازد، فقط پنل ادمین می‌خواند.
    // ═══════════════════════════════════════════════════════════════
    match /orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  هر کالکشن دیگری که این‌جا صراحتاً تعریف نشده، کاملاً بسته می‌ماند
    //  (پیش‌فرض امن — دقیقاً مثل قانون فعلی‌تان)
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
